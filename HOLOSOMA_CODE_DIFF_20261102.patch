+++ b/scripts/plot_holdout_evaluation.py
@@ -0,0 +1,68 @@
+"""Plots of every trial and a transparently selected matched highlight case."""
+import json
+from pathlib import Path
+import numpy as np
+
+MODELS=('biHAM','sym_aug_HAM','HAM','MLP')
+RIGHT=('right','forward_right','backward_right')
+
+def plot_results(output, iteration=None):
+    import matplotlib
+    matplotlib.use('Agg')
+    import matplotlib.pyplot as plt
+    output=Path(output)
+    data=[json.loads(p.read_text()) for p in output.glob('videos/*/model_*/*/metrics.json') if p.parts[-4] in MODELS]
+    plots=output/'plots'; plots.mkdir(exist_ok=True)
+    fields=[('mean_linear_rmse','Planar RMSE (m/s)','tracking_rmse'),('mean_vy_rmse','Lateral RMSE (m/s)','lateral_rmse'),('mean_survival_s','Observed duration (s)','survival_duration')]
+    for field,ylabel,name in fields:
+        fig,axes=plt.subplots(3,2,figsize=(11,10))
+        for i,direction in enumerate(RIGHT):
+            for j,speed in enumerate((.3,.6)):
+                ax=axes[i,j]
+                for model in MODELS:
+                    points=sorted([d for d in data if d['model']==model and d['direction']==direction and d['speed']==speed],key=lambda d:d['iteration'])
+                    if points: ax.plot([d['iteration']/1000 for d in points],[d[field] if d[field] is not None else np.nan for d in points],'.-',label=model)
+                ax.set(title=f'{direction} | {speed} m/s',xlabel='Training iterations (thousands)',ylabel=ylabel)
+                ax.grid(alpha=.25)
+        h,l=axes[0,0].get_legend_handles_labels(); fig.legend(h,l,loc='upper center',ncol=4)
+        fig.suptitle('All trials; errors before first failure, after 2 s warmup',y=.96,fontsize=11)
+        fig.tight_layout(rect=(0,0,1,.94))
+        for ext in ('png','svg'): fig.savefig(plots/f'{name}.{ext}',dpi=150)
+        plt.close(fig)
+    iterations=sorted({d['iteration'] for d in data}) if iteration is None else [iteration]
+    for iteration in iterations:
+        fig,axes=plt.subplots(3,3,figsize=(14,10))
+        for i,direction in enumerate(RIGHT):
+            for model in MODELS:
+                matches=[d for d in data if d['model']==model and d['iteration']==iteration and d['direction']==direction and d['speed']==.6]
+                if not matches: continue
+                d=matches[0]; c=d['curve']; t=[x['time_s'] for x in c]
+                for j in (0,1):
+                    axes[i,j].plot(t,[x['mean_velocity'][j] if x['mean_velocity'] is not None else np.nan for x in c],label=model)
+                    axes[i,j].axhline(d['command'][j],color='black',linestyle='--',alpha=.2)
+                axes[i,2].plot(t,[x['active_trials']/d['trials'] for x in c],label=model)
+            for j,label in enumerate(('vx (m/s)','vy (m/s)','Fraction still active')):
+                axes[i,j].set(title=f'{direction}: {label}',xlabel='Time (s)'); axes[i,j].grid(alpha=.25)
+        h,l=axes[0,0].get_legend_handles_labels(); fig.legend(h,l,loc='upper center',ncol=4)
+        fig.suptitle(f'{iteration:,} iterations | Active-episode mean; dashed = command',y=.96)
+        fig.tight_layout(rect=(0,0,1,.94)); fig.savefig(plots/f'velocity_curves_{iteration:07d}.png',dpi=150); plt.close(fig)
+    select_highlight(data,output)
+
+def select_highlight(data,output):
+    candidates=[]
+    for iteration, case in {(d['iteration'],d['name']) for d in data if d['direction'] in RIGHT}:
+        rows={d['model']:d for d in data if d['iteration']==iteration and d['name']==case}
+        if set(rows)!=set(MODELS): continue
+        for trial in range(rows['biHAM']['trials']):
+            values={m:rows[m]['per_trial'][trial] for m in MODELS}
+            errors={m:v['linear_rmse'] for m,v in values.items()}
+            if any(v is None for v in errors.values()) or values['biHAM']['survived_s']<19.99: continue
+            reference=values['biHAM']['initial_state']
+            state_keys=('root','dof','actor_obs') + (('domi_clock',) if reference.get('domi_clock') is not None else ())
+            if not all(all(np.allclose(values[m]['initial_state'][k],reference[k],atol=1e-4,rtol=1e-4) for k in state_keys) for m in MODELS): continue
+            ordered=errors['biHAM']<errors['sym_aug_HAM']<min(errors['HAM'],errors['MLP'])
+            candidates.append(dict(case=case,iteration=iteration,trial=trial,errors=errors,requested_order_observed=ordered,rows={m:dict(checkpoint=rows[m]['checkpoint'],initial_state=values[m]['initial_state']) for m in MODELS}))
+    if not candidates: return
+    chosen=min(candidates,key=lambda c:(c['errors']['biHAM'],c['iteration'],c['case'],c['trial']))
+    chosen['selection']='Post-hoc illustration: lowest biHAM error among survived matched rightward trials across all checkpoints; other models use the same checkpoint and initial state. Aggregate plots include ALL trials. Ranking was not a selection criterion.'
+    temp=output/'highlight_selection.tmp'; temp.write_text(json.dumps(chosen,indent=2)+'\n'); temp.replace(output/'highlight_selection.json')
diff --git a/scripts/plot_rmse_summary.py b/scripts/plot_rmse_summary.py
new file mode 100644
index 0000000000000000000000000000000000000000..6ae6262d40c82bc0e5e1f4b9f00a5933a2bd7e0c
--- /dev/null
+++ b/scripts/plot_rmse_summary.py
@@ -0,0 +1,135 @@
+"""One publication-style PNG: trained directions versus held-out directions."""
+import argparse
+import json
+from pathlib import Path
+import statistics
+import time
+
+MODELS = ('biHAM', 'sym_aug_HAM', 'HAM', 'MLP')
+LABELS = ('biHAM', 'HAM + symmetry augmentation', 'HAM', 'MLP')
+COLORS = ('#1769aa', '#e39328', '#60944e', '#8a659e')
+SEEN = ('forward', 'backward', 'left')
+HELD = ('right', 'forward_right', 'backward_right')
+
+
+def main():
+    global MODELS, LABELS, COLORS
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--evaluation', type=Path, required=True)
+    parser.add_argument('--exclude-mlp', action='store_true')
+    parser.add_argument('--mlp-evaluation', type=Path)
+    parser.add_argument('--wait-for-mlp', action='store_true')
+    parser.add_argument('--output-stem')
+    args = parser.parse_args()
+    if args.exclude_mlp:
+        MODELS, LABELS, COLORS = MODELS[:3], LABELS[:3], COLORS[:3]
+    rows = json.loads((args.evaluation / 'summary.json').read_text())
+    if args.mlp_evaluation:
+        if args.exclude_mlp:
+            parser.error('Cannot both replace and exclude MLP.')
+        names = {r['name'] for r in rows if r['model'] == 'MLP'}
+        while True:
+            source = args.mlp_evaluation / 'summary.json'
+            candidates = json.loads(source.read_text()) if source.exists() else []
+            replacement = [r for r in candidates if r['model'] == 'MLP'
+                           and r['iteration'] in range(1000, 10001, 1000) and r['name'] in names]
+            if len(replacement) == 160 and len({(r['iteration'],r['name']) for r in replacement}) == 160:
+                break
+            if not args.wait_for_mlp:
+                raise ValueError('New MLP 1k..10k evaluations are not complete yet.')
+            state = args.mlp_evaluation.parent / 'status.json'
+            if state.exists() and json.loads(state.read_text())['phase'] in ('failed','interrupted'):
+                raise RuntimeError('Evaluation stopped before replacement data completed.')
+            time.sleep(10)
+        rows = [r for r in rows if r['model'] != 'MLP'] + replacement
+        LABELS = LABELS[:3] + ('MLP (native IO, IsaacSim)',)
+
+    assert len(rows) == 640, 'Expected 4 models x 10 checkpoints x 16 cases.'
+    assert len({(r['model'], r['iteration'], r['name']) for r in rows}) == 640
+    def average(model, iteration, directions):
+        values = [r for r in rows if r['model'] == model and r['iteration'] == iteration
+                  and r['direction'] in directions]
+        assert len(values) == 2 * len(directions)
+        assert all(r['mean_linear_rmse'] is not None for r in values)
+        return statistics.mean(r['mean_linear_rmse'] for r in values)
+
+    import matplotlib
+    matplotlib.use('Agg')
+    import matplotlib.pyplot as plt
+    import numpy as np
+    plt.rcParams.update({'font.family': 'DejaVu Sans', 'font.size': 11,
+                         'axes.spines.top': False, 'axes.spines.right': False,
+                         'axes.titleweight': 'bold', 'axes.labelcolor': '#334155',
+                         'text.color': '#182b42', 'axes.edgecolor': '#a4afbd'})
+    fig = plt.figure(figsize=(15, 10), facecolor='white')
+    grid = fig.add_gridspec(2, 2, height_ratios=(1, 1.12), hspace=.48, wspace=.23)
+    axes = [fig.add_subplot(grid[0, 0]), fig.add_subplot(grid[0, 1])]
+    iterations = range(1000, 10001, 1000)
+    for ax, directions, title in zip(axes, (SEEN, HELD),
+            ('A   Training-command directions', 'B   Held-out command directions')):
+        for model, label, color in zip(MODELS, LABELS, COLORS):
+            ax.plot(range(1, 11), [average(model, i, directions) for i in iterations],
+                    color=color, marker='o', markersize=4, linewidth=2.2, label=label)
+        ax.set_title(title, loc='left', pad=28)
+        ax.set(xlabel='Training iterations (thousands)',
+               ylabel='Planar velocity RMSE (m/s)', xticks=range(1, 11), xlim=(.7, 10.3))
+        upper = max(average(m,i,directions) for m in MODELS for i in iterations)
+        ax.set_ylim(0, max(.60, upper*1.12) if args.mlp_evaluation else (.60 if args.exclude_mlp else 1.85))
+        ax.grid(axis='y', color='#e2e8f0', linewidth=.8)
+        ax.set_axisbelow(True)
+        ax.text(0, 1.02, 'Forward / backward / left' if directions == SEEN else
+                'Right / forward-right / backward-right', transform=ax.transAxes,
+                fontsize=10, color='#64748b')
+    ax = fig.add_subplot(grid[1, :])
+    directions = SEEN + HELD
+    positions = np.arange(6)
+    width = .18
+    ax.axvspan(2.5, 5.5, color='#edf5fb', zorder=0)
+    for index, (model, label, color) in enumerate(zip(MODELS, LABELS, COLORS)):
+        values = [average(model, 10000, (d,)) for d in directions]
+        bars = ax.bar(positions + (index - (len(MODELS) - 1) / 2) * width, values, width,
+                      color=color, label=label, zorder=3)
