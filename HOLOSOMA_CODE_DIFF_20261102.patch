@@ -0,0 +1,137 @@
+"""CPU-only audit of saved MLP command inputs, outputs and existing rollout scores."""
+import argparse
+import csv
+import hashlib
+import json
+import math
+from pathlib import Path
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--campaign',type=Path,required=True)
+    args=parser.parse_args()
+    root=args.campaign.resolve()
+    output=root/'command_bug_audit'
+    output.mkdir(exist_ok=True)
+    run=next((root/'training').glob('*/*/holosoma_config.yaml')).parent
+    import torch
+    from holosoma.agents.fast_sac.fast_sac import Actor
+    from holosoma.agents.fast_sac.fast_sac_utils import EmpiricalNormalization
+    from holosoma.utils.rotations import quat_rotate_inverse
+    from holosoma.simulator.isaacsim.proxy_utils import RootStatesProxy
+    torch.set_num_threads(1)
+    assert not torch.cuda.is_available()
+    result=dict(scope='CPU only: existing checkpoints, saved initial observations and saved rollout logs; no new simulation or training.',
+        audit=json.loads((run/'command_audit_status.json').read_text()),checkpoints=[])
+
+    # Independent analytic cases: identity and a +90-degree yaw.
+    q=torch.tensor([[0.,0.,0.,1.],[0.,0.,math.sqrt(.5),math.sqrt(.5)]])
+    world=torch.tensor([[0.,1.,0.],[0.,1.,0.]])
+    expected=torch.tensor([[0.,1.,0.],[1.,0.,0.]])
+    native=torch.zeros(2,13);native[:,3:7]=q[:,[3,0,1,2]];native[:,7:10]=world
+    proxy=RootStatesProxy(native)
+    body=quat_rotate_inverse(proxy[:,3:7],proxy[:,7:10],w_last=True)
+    result['quaternion_known_cases_max_error']=float((body-expected).abs().max())
+    assert torch.allclose(body,expected,atol=1e-6)
+
+    # This known native running-variance issue is tested separately from OOD behavior.
+    n=EmpiricalNormalization(1,'cpu')
+    n(torch.tensor([[0.],[0.]]));n(torch.tensor([[2.],[2.]]))
+    all_samples=torch.tensor([0.,0.,2.,2.])
+    result['native_running_variance_counterexample']=dict(saved_mean=float(n._mean[0,0]),
+        expected_mean=float(all_samples.mean()),saved_variance=float(n._var[0,0]),
+        expected_variance=float(all_samples.var(unbiased=False)),
+        note='Known native variance-merge error; this test does not establish a cause of OOD locomotion.')
+
+    for iteration in (10000,30000):
+        checkpoint=run/('model_%07d.pt'%iteration)
+        state=torch.load(checkpoint,map_location='cpu',weights_only=False,mmap=True)
+        ac=state['experiment_config']['algo']['config']
+        assert not ac['use_symmetry'] and not ac['symmetry_compatible_io'] and ac['bilateral'] is None
+        ns=state['obs_normalizer_state']
+        dim=ns['_mean'].numel();assert dim==100
+        actor=Actor({'actor_obs':dict(start=0,end=dim,size=dim)},['actor_obs'],29,1,
+            ac['actor_hidden_dim'],ac['log_std_max'],ac['log_std_min'],
+            use_tanh=ac['use_tanh'],use_layer_norm=ac['use_layer_norm'],device='cpu')
+        actor.load_state_dict(state['actor_state_dict'],strict=True);actor.eval()
+        norm=EmpiricalNormalization(dim,'cpu');norm.load_state_dict(ns);norm.eval()
+        before={k:v.clone() for k,v in norm.state_dict().items()}
+        samples=[];metrics=[]
+        for path in sorted((root/'evaluation/videos/MLP'/checkpoint.stem).glob('*/metrics.json')):
+            case=json.loads(path.read_text())
+            samples.extend(t['initial_state']['actor_obs'] for t in case['per_trial'])
+            if case['direction'] in ('right','left','standing'):
+                trials=[t for t in case['per_trial'] if t['linear_rmse'] is not None]
+                recomputed=sum(t['linear_rmse'] for t in trials)/len(trials)
+                assert abs(recomputed-case['mean_linear_rmse'])<1e-8
+                metrics.append(dict(case=case['name'],command=case['command'],
+                    rmse=recomputed,zero_velocity_baseline_rmse=math.hypot(*case['command'][:2]),
+                    trials=case['trials'],successes=case['successes'],failure_rate=case['failure_rate'],
+                    mean_velocity=[sum(t['mean_velocity'][k] for t in trials)/len(trials) for k in (0,1)]))
+        assert len(samples)==544
+        observations=torch.tensor(samples)
+        values=(-.9,-.6,-.3,0.,.3,.6,.9)
+        actions={};sweep=[]
+        with torch.no_grad():
+            for vy in values:
+                x=observations.clone();x[:,[33,34,32]]=torch.tensor([0.,vy,0.])
+                normalized=norm(x,update=False)
+                manual=(x-norm._mean)/(norm._std+norm.eps)
+                assert torch.equal(normalized,manual)
+                action=actor(normalized)[0];assert torch.isfinite(action).all()
+                actions[vy]=action
+                sweep.append(dict(command_vy=vy,normalized_vy=float(normalized[0,34]),
+                    action_rms=float(action.square().mean().sqrt())))
+            for row in sweep:
+                delta=actions[row['command_vy']]-actions[0.]
+                row.update(action_change_from_zero_rms=float(delta.square().mean().sqrt()),
+                    fraction_states_with_changed_action=float((delta.abs().amax(-1)>1e-6).float().mean()))
+            left_delta=actions[.6]-actions[0.]
+            right_delta=actions[0.]-actions[-.6]
+            cosine=torch.nn.functional.cosine_similarity(left_delta,right_delta,dim=-1)
+        frozen=all(torch.equal(before[k],v) for k,v in norm.state_dict().items())
+        assert frozen
+        result['checkpoints'].append(dict(iteration=iteration,checkpoint=str(checkpoint),
+            actor_class=type(actor).__name__,strict_weight_load=True,
+            use_symmetry=ac['use_symmetry'],symmetry_compatible_io=ac['symmetry_compatible_io'],
+            bilateral=ac['bilateral'],state_count=len(samples),normalizer_unchanged=frozen,
+            command_indices_vx_vy_yaw=[33,34,32],sweep=sweep,
+            opposite_command_deltas_cosine_mean=float(cosine.mean()),
+            opposite_command_deltas_cosine_median=float(cosine.median()),
+            rollout_metrics=metrics,
+            limitation='Frozen-state action sensitivity is not a closed-loop command-clamp intervention.'))
+        print('AUDIT_CHECKPOINT '+str(iteration)+' '+json.dumps(result['checkpoints'][-1]),flush=True)
+
+    clips=[]
+    for name in ('left','right','switch'):
+        folder=root/'video_preview_10k'/name
+        with (folder/'commands.csv').open() as stream:
+            rows=list(csv.DictReader(stream))
+        if name=='switch':
+            clips.append(dict(name=name,rows=len(rows),commands=sorted({
+                tuple(round(float(r[k]),5) for k in ('command_vx','command_vy','command_yaw')) for r in rows})))
+            continue
+        measured=[r for r in rows if float(r['time_s'])>=2.]
+        raw=lambda r,k:float(r[k])
+        error=sum((raw(r,'actual_vx')-raw(r,'command_vx'))**2+
+                  (raw(r,'actual_vy')-raw(r,'command_vy'))**2 for r in measured)
+        mse=error/len(measured)
+        mean=[sum(raw(r,k) for r in measured)/len(measured) for k in ('actual_vx','actual_vy')]
+        meta=json.loads((folder/'video.json').read_text())
+        clips.append(dict(name=name,rows=len(rows),csv_recomputed_planar_rmse=math.sqrt(mse),
+            video_metric_planar_rmse=meta['linear_rmse'],
+            mean_body_velocity=mean,
+            manager_policy_command_checked_each_step=meta['actual_policy_commands_verified'],
+            note='CSV is pre-action; video metric is post-action, giving a one-step timing offset.'))
+    result['existing_video_command_checks']=clips
+    source_paths=[Path(__file__),Path('scripts/evaluate_command_holdout.py'),
+        Path('src/holosoma/holosoma/agents/fast_sac/fast_sac.py'),
+        Path('src/holosoma/holosoma/agents/fast_sac/fast_sac_utils.py')]
+    result['source_sha256']={str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in source_paths}
+    (output/'report.json').write_text(json.dumps(result,indent=2,allow_nan=False)+'\n')
+    print(json.dumps(result,indent=2),flush=True)
+
+
+if __name__=='__main__':
+    main()
diff --git a/scripts/biham_mlp_command_replay.html b/scripts/biham_mlp_command_replay.html
new file mode 100644
index 0000000..dbe9341
--- /dev/null
+++ b/scripts/biham_mlp_command_replay.html
@@ -0,0 +1,39 @@
+<!doctype html><html lang="ko"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<title>biHAM · MLP | Command replay</title>
+<style>body{max-width:1550px;margin:28px auto;padding:0 22px;background:#111b2a;color:#e8eef7;font:16px/1.65 system-ui}h1{margin-bottom:5px}p{color:#bdcbdc}a{color:#80c6ff}select,button{font:inherit;padding:9px;margin:8px 12px 18px 0;border-radius:6px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.card{background:#1c293b;padding:20px;border-radius:14px}video{width:100%;background:#d9dfe6;border-radius:8px}.pending{padding:55px 22px;background:#24344a;border-radius:8px}.badge{font-size:13px;color:#bbd2f0}@media(max-width:900px){.grid{grid-template-columns:1fr}}</style>
+<h1>biHAM · MLP — 명령과 실제 움직임</h1>
+<p>파란 로봇 / 밝은 격자 바닥 · <b style="color:#ffb641">주황: 목표 커맨드</b> · <b style="color:#4edcff">하늘색: 실제 body-frame 속도</b><br>영상 상단에 vx·vy·yaw와 시간이 표시되고, 오른쪽 아래에 로봇 좌표계 방향 화살표가 표시됩니다.</p>
+<select id="case"><option value="left">학습 방향: 왼쪽 +0.6 m/s</option><option value="right">테스트 방향: 오른쪽 −0.6 m/s</option></select>
+<button id="play">두 영상 처음부터 재생</button><div id="cards" class="grid"></div>
+<p>두 모델 모두 10k 저장 정책을 별도 1env에서 재생합니다. biHAM은 기존 v2(IsaacGym 학습, reflection 정규화·domi phase), MLP는 새 native 모델(IsaacSim 학습, empirical 정규화·기본 phase)입니다. 학습 당시 녹화본이나 동일한 학습 조건의 비교 영상은 아닙니다.</p>
+<script>
+const models=[
+ {label:'biHAM · 10k',base:'biHAM/',description:'기존 v2 · reflection normalization · domi phase'},
+ {label:'MLP · 10k',base:'../vanilla_mlp_30k_native_io_gpu2/video_preview_10k/',description:'새 vanilla MLP · empirical normalization · native phase'}
+];
+async function read(url){try{const r=await fetch(url,{cache:'no-store'});return r.ok?await r.json():null}catch{return null}}
+async function refresh(){
+ const box=document.querySelector('#cards'),selection=document.querySelector('#case').value;
+ if([...box.querySelectorAll('video')].some(v=>!v.paused))return;
+ const cards=await Promise.all(models.map(async model=>{
+  const folder=model.base+selection+'/',data=await read(folder+'video.json');
+  const card=document.createElement('section');card.className='card';
+  const h=document.createElement('h2');h.textContent=model.label;card.append(h);
+  const detail=document.createElement('p');detail.className='badge';detail.textContent=model.description;card.append(detail);
+  if(data?.web_file){
+   const v=document.createElement('video');v.controls=true;v.playsInline=true;v.preload='metadata';v.poster=folder+'preview.png';v.src=folder+data.web_file;card.append(v);
+   const status=document.createElement('p');status.textContent=data.simulated_seconds.toFixed(1)+'초 · '+(data.terminated?'조기 종료':'완주')+(data.linear_rmse==null?'':' · 이 영상 planar RMSE '+data.linear_rmse.toFixed(3)+' m/s');card.append(status);
+   for(const [href,text] of [[v.src,'MP4 다운로드'],[folder+'commands.csv','실제 명령·속도 CSV']]){const a=document.createElement('a');a.href=href;a.textContent=text;a.style.marginRight='15px';card.append(a)}
+  }else{
+   const pending=document.createElement('div');pending.className='pending';
+   const state=await read(model.base+'status.json');
+   pending.textContent=state?.phase==='starting'?'GPU2에서 시뮬레이터 초기화 중입니다.':state?.phase==='rendering'?'같은 고대비 스타일로 렌더링 중입니다. 완료되면 여기에 표시됩니다.':state?.phase==='failed'?'렌더링 오류 확인 중입니다.':'같은 고대비 스타일 렌더러 준비 완료. 사용할 GPU 지정 대기 중입니다.';
+   card.append(pending);
+  }return card;
+ }));
+ box.replaceChildren(...cards);
+}
+document.querySelector('#case').onchange=()=>{document.querySelectorAll('video').forEach(v=>v.pause());refresh()};
+document.querySelector('#play').onclick=()=>document.querySelectorAll('video').forEach(v=>{v.currentTime=0;v.play().catch(()=>{})});
+refresh();setInterval(refresh,10000);
+</script></html>
diff --git a/scripts/command_distributions_dashboard.html b/scripts/command_distributions_dashboard.html
new file mode 100644
index 0000000..2c41676
--- /dev/null
+++ b/scripts/command_distributions_dashboard.html
@@ -0,0 +1,66 @@
+<!doctype html>
+<html lang="ko"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<title>실제 커맨드 분포 · 정규화 전후</title>
+<style>
+body{margin:25px auto;padding:0 22px;max-width:1450px;font:15px/1.65 system-ui,sans-serif;background:#f3f6fb;color:#17243a}h1{margin-bottom:5px;font-size:27px}p{margin:5px 0 14px}.muted{color:#566780}a{color:#245fc1;margin-right:15px}.controls{padding:15px 19px;background:white;border:1px solid #dce4ef;border-radius:12px;display:flex;gap:24px;flex-wrap:wrap;align-items:center;margin:18px 0}select{padding:7px;font:inherit;border:1px solid #b8c6d9;border-radius:6px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.card{padding:16px 20px;background:white;border:1px solid #dce4ef;border-radius:12px}h2{font-size:18px;margin:0 0 3px}canvas{width:100%;height:300px;display:block}.summary{font-size:13px;color:#566780}.note{background:#e7effb;border-left:4px solid #3971c6;padding:11px 15px;border-radius:5px}input{vertical-align:middle}.blue{color:#2865ce}.green{color:#159575}@media(max-width:850px){.grid{grid-template-columns:1fr}h1{font-size:23px}}
+</style>
+<h1>실제 커맨드 분포 · 정규화 이전 / 이후</h1>
+<p class="muted">vx · vy · yaw 각각의 분포를 선으로 비교합니다. 왼쪽은 raw command, 오른쪽은 학습 당시 실제 기록된 normalized command입니다.</p>
+<p><a href="./">전체 통계 대시보드</a><a href="command_distributions.png">비율 그래프 PNG</a><a href="command_distributions.svg">SVG</a><a href="command_probability_density.png">확률밀도 PNG</a><a href="command_distribution_curves.csv">곡선 데이터 CSV</a></p>
+<div class="controls">
+<label>세로축 <select id="mode"><option value="ratio">구간별 표본 비율 (%)</option><option value="density">확률밀도</option></select></label>
+<label>분포 구간 수 <input id="bins" type="range" min="30" max="150" step="10" value="80"> <b id="binLabel">80</b></label>
+<span id="sampleCount" class="muted"></span></div>
+<div class="grid" id="plots"></div>
+<p class="note">실제 CSV에 남긴 env 0 표본을 사용합니다. 같은 명령이 유지된 매 timestep을 각각 셉니다. Gaussian/KDE 스무딩 없이 구간별 비율·밀도를 선으로 연결하므로, 오른쪽 raw vy 표본을 인위적으로 만들지 않습니다. 0 명령이 많아 뾰족한 봉우리가 생길 수 있습니다.</p>
+<p class="muted">정규화 후 가로축은 속도의 물리 단위가 없는 정규화 값입니다. 이후 분포는 고정 체크포인트 통계로 다시 계산한 값이 아니라 CSV의 normalized_vx / normalized_vy / normalized_yaw 그대로입니다. 확률밀도는 비율을 구간 폭으로 나눈 값으로, 각 구간의 밀도×폭을 더하면 1입니다.</p>
+<script>
+const $=id=>document.getElementById(id);
+let data;
+const names=['vx','vy','yaw'];
+const labels={vx:'전후 속도 vx',vy:'좌우 속도 vy',yaw:'회전 속도 yaw'};
+function curve(values,n){
+ const lo=Math.min(...values),hi=Math.max(...values),dx=(hi-lo||1)/n,bins=Array(n).fill(0);
+ for(const v of values)bins[Math.max(0,Math.min(n-1,Math.floor((v-lo)/dx)))]++;
+ const points=bins.map((count,i)=>({x:lo+(i+.5)*dx,ratio:100*count/values.length,density:count/(values.length*dx)}));
+ return {points,lo,hi,dx};
+}
+function draw(id,result,field,channel,normalized){
+ const canvas=$(id),w=canvas.clientWidth,h=canvas.clientHeight,dpr=devicePixelRatio||1;
+ canvas.width=w*dpr;canvas.height=h*dpr;const c=canvas.getContext('2d');c.scale(dpr,dpr);
+ const l=64,r=20,t=27,b=49;
+ let xmin=result.lo,xmax=result.hi,pad=(xmax-xmin||1)*.045;
+ xmin-=pad;xmax+=pad;
+ if(channel==='vy'&&!normalized)xmin=Math.min(xmin,-.12);
+ const ymax=Math.max(...result.points.map(p=>p[field]))*1.16||1;
+ const X=x=>l+(x-xmin)/(xmax-xmin)*(w-l-r),Y=y=>h-b-y/ymax*(h-t-b);
+ c.font='12px system-ui';c.fillStyle='#61728b';c.textAlign='right';c.lineWidth=1;
+ for(let i=0;i<=4;i++){let y=i*ymax/4;c.strokeStyle='#e4eaf3';c.beginPath();c.moveTo(l,Y(y));c.lineTo(w-r,Y(y));c.stroke();c.fillText(y.toFixed(field==='ratio'?1:2),l-8,Y(y)+4)}
+ c.textAlign='center';
+ for(let i=0;i<=5;i++){let x=xmin+i*(xmax-xmin)/5;c.fillText(x.toFixed(2),X(x),h-b+20)}
+ const xlabel=normalized?'normalized '+channel+' (단위 없음)':channel+(channel==='yaw'?' (rad/s)':' (m/s)');
+ c.fillText(xlabel,w/2,h-6);c.textAlign='left';c.fillText(field==='ratio'?'표본 비율 (%)':'확률밀도',8,14);
+ if(xmin<=0&&xmax>=0){c.strokeStyle='#aab8cb';c.setLineDash([4,4]);c.beginPath();c.moveTo(X(0),t);c.lineTo(X(0),h-b);c.stroke();c.setLineDash([])}
+ c.strokeStyle=normalized?'#159575':'#2865ce';c.lineWidth=2.1;c.beginPath();
+ result.points.forEach((p,i)=>i?c.lineTo(X(p.x),Y(p[field])):c.moveTo(X(p.x),Y(p[field])));c.stroke();
+}
+function render(){
+ const n=+$('bins').value,field=$('mode').value;
+ $('binLabel').textContent=n;
+ $('sampleCount').textContent='실제 env 0 표본 '+data.sample.raw.length.toLocaleString()+'개';
+ for(const [index,name] of names.entries())for(const normalized of [false,true]){
+  const key=normalized?'normalized':'raw',values=data.sample[key].map(row=>row[index]),id=key+'_'+name;
+  const result=curve(values,n);
+  draw(id,result,field,name,normalized);
+  const mean=values.reduce((a,b)=>a+b,0)/values.length;
+  const negative=values.filter(v=>v<0).length;
+  $(id+'_summary').textContent='평균 '+mean.toFixed(4)+' · 범위 ['+result.lo.toFixed(4)+', '+result.hi.toFixed(4)+'] · 음수 '+(100*negative/values.length).toFixed(2)+'% · 구간 폭 '+result.dx.toFixed(4);
+ }
+}
+fetch('data.json').then(r=>{if(!r.ok)throw Error(r.status);return r.json()}).then(d=>{
+ data=d;
+ $('plots').innerHTML=names.flatMap(name=>[false,true].map(normalized=>{const key=normalized?'normalized':'raw',id=key+'_'+name;return '<section class="card"><h2 class="'+(normalized?'green':'blue')+'">'+labels[name]+' · '+(normalized?'정규화 이후':'정규화 이전')+'</h2><canvas id="'+id+'"></canvas><div class="summary" id="'+id+'_summary"></div></section>'})).join('');
+ render();$('mode').addEventListener('change',render);$('bins').addEventListener('input',render);
+ let timer;window.addEventListener('resize',()=>{clearTimeout(timer);timer=setTimeout(render,120)});
+}).catch(e=>document.body.insertAdjacentHTML('beforeend','<p>분포 데이터를 읽지 못했습니다: '+e.message+'</p>'));
+</script></html>
