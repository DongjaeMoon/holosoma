+from __future__ import annotations
+"""Joint-list statements copied from domi make_obs_cfg / make_act_cfg."""
+
+def observation_joint_names(side, include_else=True):
+    cont = "right" if side == "left" else "left"
+    joint_names = [
+        # waist
+        'waist_yaw_joint',
+        'waist_roll_joint',
+        'waist_pitch_joint',
+
+        # leg
+        F'{side}_ankle_roll_joint',
+        F'{side}_ankle_pitch_joint',
+        F'{side}_hip_pitch_joint',
+        F'{side}_hip_roll_joint',
+        F'{side}_hip_yaw_joint',
+        F'{side}_knee_joint',
+
+        # arm
+        F'{side}_shoulder_pitch_joint',
+        F'{side}_shoulder_roll_joint',
+        F'{side}_shoulder_yaw_joint',
+        F'{side}_elbow_joint',
+        F'{side}_wrist_roll_joint',
+        F'{side}_wrist_pitch_joint',
+        F'{side}_wrist_yaw_joint',
+    ]
+
+    if include_else:
+        # include the "flip-side" joints for subnet, in multi-agent scenarios.
+        # cont stand for "contralateral side"
+        k_cont = [
+            F'{cont}_ankle_roll_joint',
+            F'{cont}_ankle_pitch_joint',
+            F'{cont}_hip_pitch_joint',
+            F'{cont}_hip_roll_joint',
+            F'{cont}_hip_yaw_joint',
+            F'{cont}_knee_joint',
+            F'{cont}_shoulder_pitch_joint',
+            F'{cont}_shoulder_roll_joint',
+            F'{cont}_shoulder_yaw_joint',
+            F'{cont}_elbow_joint',
+            F'{cont}_wrist_roll_joint',
+            F'{cont}_wrist_pitch_joint',
+            F'{cont}_wrist_yaw_joint',
+        ]
+        joint_names.extend(k_cont)
+
+    return joint_names
+
+def action_joint_names(side, arm=True, skip_waist=False):
+    waist_names = [
+        'waist_yaw_joint',
+        'waist_roll_joint',
+        'waist_pitch_joint',
+    ]
+
+    leg_names = [
+        # leg
+        F"{side}_hip_pitch_joint",
+        F"{side}_hip_roll_joint",
+        F"{side}_hip_yaw_joint",
+        F"{side}_knee_joint",
+        F"{side}_ankle_pitch_joint",
+        F"{side}_ankle_roll_joint",
+    ]
+
+    if skip_waist:
+        joint_names = leg_names
+    else:
+        joint_names = [*waist_names, *leg_names]
+
+    if arm:
+        joint_names.extend([
+            F'{side}_shoulder_pitch_joint',
+            F'{side}_shoulder_roll_joint',
+            F'{side}_shoulder_yaw_joint',
+            F'{side}_elbow_joint',
+            F'{side}_wrist_roll_joint',
+            F'{side}_wrist_pitch_joint',
+            F'{side}_wrist_yaw_joint'
+        ])
+    return joint_names
diff --git a/src/holosoma/holosoma/agents/modules/bilateral/original/layers.py b/src/holosoma/holosoma/agents/modules/bilateral/original/layers.py
new file mode 100644
index 0000000000000000000000000000000000000000..a7d75002bbd0397de750d470400bd2ea16f61bc3
--- /dev/null
+++ b/src/holosoma/holosoma/agents/modules/bilateral/original/layers.py
@@ -0,0 +1,281 @@
+from __future__ import annotations
+"""Original layer helpers; function/class bodies copied verbatim."""
+from typing import Tuple, Optional, Union, Callable
+import numpy as np
+import torch as th
+from torch import nn
+import einops
+from .export_compat import tensorrt_compat_enabled
+LN_NAMES = ["ln", "layer_norm", "layernorm"]
+BN_NAMES = ["bn", "batch_norm", "batchnorm"]
+GN_NAMES = ["gn", "group_norm", "groupnorm"]
+
+def get_activation_function(actv: str) -> nn.Module:
+    if not isinstance(actv, str):
+        return actv
+    actv = actv.lower()
+    if actv == 'tanh':
+        out = nn.Tanh
+    elif actv == 'relu':
+        out = nn.ReLU
+    elif actv == 'lrelu':
+        out = nn.LeakyReLU
+    elif actv == 'leaky_relu':
+        out = nn.LeakyReLU
+    elif actv == 'elu':
+        out = nn.ELU
+    elif actv == 'relu6':
+        out = nn.ReLU6
+    elif actv == 'gelu':
+        out = nn.GELU
+    elif actv == 'selu':
+        out = nn.SELU
+    elif actv == 'silu':
+        out = nn.SiLU
+    elif actv == 'none':
+        out = nn.Identity
+    else:
+        raise KeyError(F'Unknown actv={actv}')
+    return out
+
+
+class BatchNorm1d(nn.BatchNorm1d):
+    def __init__(self,
+                 num_features: int,
+                 eps: float = 1e-5,
+                 affine: bool = True,
+                 *args, **kwds):
+        kwds.pop('num_groups', None)
+        super().__init__(num_features, eps, affine=affine)
+
+    def forward(self, input: th.Tensor) -> th.Tensor:
+        batch_shape = input.shape[:-1]
+        out = super().forward(input.reshape(-1, input.shape[-1]))
+        return out.view(*batch_shape, out.shape[-1])
+
+
+class LayerNorm1d(nn.LayerNorm):
+    def __init__(self,
+                 num_features: int,
+                 eps: float = 1e-5,
+                 affine: bool = True,
+                 *args, **kwds):
+        kwds.pop('num_groups', None)
+        super().__init__(num_features, eps, affine, *args, **kwds)
+
+    def forward(self, input: th.Tensor) -> th.Tensor:
+        batch_shape = input.shape[:-1]
+        out = super().forward(input.reshape(-1, input.shape[-1]))
+        return out.view(*batch_shape, out.shape[-1])
+
+
+class GroupNorm1d(nn.GroupNorm):
+    def __init__(self,
+                 num_features: int,
+                 eps: float = 1e-5,
+                 affine: bool = True,
+                 *args, **kwds):
+        # assert num_features % num_groups == 0
+        num_groups = kwds.pop('num_groups')
+        super().__init__(num_groups, num_features, eps, affine=affine, *args, **kwds)
+        # for k, v in self.named_parameters():
+        #     print('par', k, v.shape)
+
+        # for k, v in self.named_buffers():
+        #     print('buf', k, v.shape)
+
+    def forward(self, input: th.Tensor) -> th.Tensor:
+        batch_shape = input.shape[:-1]
+        out = super().forward(input.reshape(-1, input.shape[-1]))
+        return out.view(*batch_shape, out.shape[-1])
+
+
+def get_normalization_function(norm_cls: str) -> nn.Module:
+    if isinstance(norm_cls, Callable):
+        return norm_cls
+
+    if norm_cls is None:
+        return nn.Identity
+
+    norm_cls = norm_cls.lower()
+    if norm_cls in LN_NAMES:
+        # NOTE(ycho): LayerNorm1d wraps nn.LayerNorm
+        # to provide a consistent interface w.r.t. BatchNorm1d
+        out = LayerNorm1d
+    elif norm_cls in BN_NAMES:
+        out = BatchNorm1d
+    elif norm_cls in GN_NAMES:
+        out = GroupNorm1d
+    elif norm_cls in ['none']:
+        out = nn.Identity
+    else:
+        raise KeyError(F'Unknown norm_cls={norm_cls}')
+    return out
+
+
+class LinearNorm(nn.Module):
+    """ Linear layer with optimal batch normalization. """
+
+    def __init__(self,
+                 dim_in: int,
+                 dim_out: int,
+                 norm: Optional[str] = None,
+                 **kwds):
+        super().__init__()
+
+        affine = kwds.pop('affine', False)
+        bias = kwds.pop('bias', True)
+        self.dim_out = dim_out
+        self.norm = get_normalization_function(norm)(
+            num_features=dim_out,
+            affine=affine)
+        if isinstance(self.norm, BatchNorm1d):
+            bias = False
+        self.linear = nn.Linear(
+            dim_in, dim_out, bias=bias,
+            **kwds)
+
+    def forward(self, x: th.Tensor) -> th.Tensor:
+        x = self.linear(x)
+        s = x.shape
+        if (self.dim_out <= 0):
+            # -- empty output --
+            return th.empty((*s[:-1], self.dim_out),
+                            dtype=x.dtype,
+                            device=x.device)
+        else:
+            x = x.reshape(-1, s[-1])
+            x = self.norm(x)
+            x = x.reshape(s)
+        return x
+
+
+class MLP(nn.Sequential):
+    """ Generic multilayer perceptron. """
+
+    def __init__(self,
+                 dims: Tuple[int, ...],
+                 bias: bool = True,
+                 actv: nn.Module = nn.LeakyReLU,
+                 norm: Optional[str] = 'layernorm',
+                 affine: bool = False,
+                 activate_output: bool = False,
+                 **kwds
+                 ):
+        super().__init__()
+        assert (len(dims) >= 2)
+
+        if isinstance(actv, str):
+            actv = get_activation_function(actv)
+
+        layers = []
+        # hidden layers
+        for d0, d1 in zip(dims[:-2], dims[1:-1]):
+            layers.extend(
+                (LinearNorm(
+                    d0,
+                    d1,
+                    bias=bias,
+                    norm=norm,
+                    affine=affine,
+                    **kwds
+                ),
+                    actv(),
+                ))
+        # last layer
+        if activate_output:
+            layers.extend((
+                LinearNorm(
+                    dims[-2],
+                    dims[-1],
+                    bias=bias,
+                    norm=norm,
+                    affine=affine,
+                    **kwds
+                ),
+                actv()))
+        else:
+            # FIXME(ycho): not much I can do here except
+            # hardcoding... for now
+            layers.extend((
+                nn.Linear(dims[-2], dims[-1], bias=bias),)
+            )
+        super().__init__(*layers)
+        self.dims = dims
+
+
+class _Symmetric(nn.Module):
+    def __init__(self, weight: th.Tensor,) -> None:
+        super().__init__()
+
+    def forward(self, weight: th.Tensor) -> th.Tensor:
+        if len(weight.shape) == 1:
+            # bias
+            o, = weight.shape
+            w = weight
+            return einops.repeat(w[:], '... d -> ... (2 d)')
+
+        if len(weight.shape) == 2:
+            # weight
+            o, i = weight.shape
+            w = weight
+            w_self = w[:, :i // 2]
+            w_cross = w[:, i // 2:]
+            w0 = th.cat([w_self, w_cross], dim=1)
+            w1 = th.cat([w_cross, w_self], dim=1)
+            w = th.cat([w0, w1], dim=0)
+            return w
+
+    def right_inverse(self, value: th.Tensor) -> th.Tensor:
+        if len(value.shape) == 1:
+            o, = value.shape
+            w = value
+            return w[:o // 2]
+        o, i = value.shape
+        w = value
+        return w[:o // 2]
+
+
+def symmetric(module: nn.Linear,) -> nn.Module:
+    weight = getattr(module, 'weight', None)
+    bias = getattr(module, 'bias', None)
+
+    symw = _Symmetric(weight)
+    nn.utils.parametrize.register_parametrization(
+        module, 'weight', symw, unsafe=True)
+    symb = _Symmetric(bias)
+    nn.utils.parametrize.register_parametrization(
+        module, 'bias', symb, unsafe=True)
+
+    return module
+
+
+class SplitDim(nn.Module):
+    def __init__(self,
+                 sizes: Tuple[int, ...],
+                 dim: int = -1):
+        super().__init__()
+        self.dim = dim
+        self.sizes = sizes
+        self.splits = np.cumsum(sizes)[:-1].tolist()
+        # assert(dim==-1)
+        i1 = np.cumsum(sizes).tolist()
+        i0 = i1 - np.asarray(sizes)
+        self.i0=i0
+        self.i1=i1
+
+    def extra_repr(self):
+        src = sum(self.sizes)
+        return F'{src}->{self.sizes}'
+
+    def forward(self, x: th.Tensor):
+        if not tensorrt_compat_enabled():
+            return th.tensor_split(x, self.splits, dim=self.dim)
+        out = [x[..., a:b] for (a,b) in zip(self.i0, self.i1)]
+        # alt = th.tensor_split(x, self.splits, dim=self.dim)
+        #print(len(out), len(alt))
+        #assert(len(alt) == len(out))
+        #for aa, bb in zip(out, alt):
+        #    assert( (aa==bb).all())
+        return out
+
diff --git a/src/holosoma/holosoma/agents/modules/bilateral/original/loco_action_mapping.py b/src/holosoma/holosoma/agents/modules/bilateral/original/loco_action_mapping.py
new file mode 100644
index 0000000000000000000000000000000000000000..e384e6c39a5ab1649ba86fb7a0bafe2970736d20
--- /dev/null
+++ b/src/holosoma/holosoma/agents/modules/bilateral/original/loco_action_mapping.py
@@ -0,0 +1,212 @@
+"""Resolve locomotion action ownership before constructing Isaac managers.
+
+The resulting config is the physical joint map. There is no private runtime
+remapping, and reapplying the resolver (including after Hydra) is idempotent.
+"""
+from __future__ import annotations
+
+from collections.abc import Mapping
+import re
+
+
+JOINT_CONTROL_REWARDS = (
+    "help_qdev", "safe_energy", "safe_torque", "safe_speed",
+    "safe_torque_lim", "safe_qlim", "safe_vlim",
+)
+
+
+def _get(obj, name, default=None):
+    return obj.get(name, default) if isinstance(obj, Mapping) else getattr(obj, name, default)
+
+
+def _set(obj, name, value):
+    if isinstance(obj, dict):
+        obj[name] = value
+    else:
+        setattr(obj, name, value)
+
+
+def _names(selectors, names, *, unique=True):
+    """Expand selectors in authored order; action selectors must not overlap."""
+    if selectors is None:
+        return list(names)
+    if isinstance(selectors, str):
+        selectors = [selectors]
+    result = []
+    for selector in selectors:
+        matches = [name for name in names if re.fullmatch(selector, name)]
+        if not matches:
+            raise ValueError(f"Joint/body selector {selector!r} matches no configured G1 names.")
+        for name in matches:
+            if name in result:
+                if unique:
+                    raise ValueError(f"Overlapping action selectors for {name!r}.")
+            else:
+                result.append(name)
+    return result
+
+
+def _values(value, names, default):
+    if not isinstance(value, Mapping):
+        return [value] * len(names)
+    result = dict.fromkeys(names, default)
+    assigned = set()
+    for selector, item in value.items():
+        for name in _names(selector, names):
+            if name in assigned:
+                raise ValueError(f"Overlapping action parameter selectors for {name!r}.")
+            result[name] = item
+            assigned.add(name)
+    return [result[name] for name in names]
+
+
+def _arm_sign(name, arm_signs):
+    if not name.startswith(("left_", "right_")):
+        return None
+    return next((sign for pattern, sign in arm_signs.items()
+                 if re.fullmatch(pattern, name)), None)
+
+
+def validate_action_pair(actions):
+    left, right = (_get(actions, f"{side}_joint_pos") for side in ("left", "right"))
+    if left is not None and right is not None:
+        if _get(left, "contralateral_arms", False) != _get(right, "contralateral_arms", False):
+            raise ValueError(
+                "Set contralateral_arms to the same value on both "
+                "env.actions.left_joint_pos and env.actions.right_joint_pos.")
+
+
+def resolve_shared_joint_action(cfg, joint_names, arm_signs, *, side=None):
+    """Declare destination names and signed affine maps, retaining slot order.
+
+    An arm changes sides only when its *declared physical side* differs from
+    the requested side. This avoids hidden state and also supports toggling a
+    previously resolved config back to ipsilateral control.
+    """
+    names = _names(cfg.joint_names, joint_names)
+    # Archived/Hydra dictionaries may use integer literals for floating-point
+    # parameters (notably alpha=1). Keep Isaac's tensor assignments in float.
+    for field in ("scale", "offset", "alpha"):
+        value = getattr(cfg, field)
+        setattr(cfg, field, {key: float(item) for key, item in value.items()}
+                if isinstance(value, Mapping) else float(value))
+    declared_side = _get(cfg, "policy_side", "")
+    if side and declared_side and side != declared_side:
+        raise ValueError(f"Action policy_side={declared_side!r} disagrees with term side={side!r}.")
+    side = side or declared_side
+    if not side:
+        leg_sides = {name.split("_", 1)[0] for name in names
+                     if re.fullmatch(r"(left|right)_(hip_.*|knee|ankle_.*)_joint", name)}
+        if len(leg_sides) == 1:
+            side = leg_sides.pop()
+    if not any(_arm_sign(name, arm_signs) is not None for name in names):
+        cfg.joint_names = names
+        return
+    if side not in ("left", "right"):
+        raise ValueError("An arm action without a single leg side needs policy_side='left' or 'right'.")
+    cfg.policy_side = side
+    arm_side = ({"left": "right", "right": "left"}[side]
+                if cfg.contralateral_arms else side)
+    routed, signs = [], []
+    for name in names:
+        sign = _arm_sign(name, arm_signs)
+        dest = arm_side + "_" + name.split("_", 1)[1] if sign is not None else name
+        routed.append(dest)
+        signs.append(sign if name != dest else 1.0)
+    if len(set(routed)) != len(routed):
+        raise ValueError("An action term cannot control both arms in the same slots.")
+    if routed != names:
+        # Resolve in source coordinates before renaming any selector. Alpha and
+        # raw-action bounds follow slots; signed scales and explicit offsets
+        # reflect into destination joint coordinates. Asset default offsets
+        # are still read normally by JointPositionAction from destination IDs.
+        for field, default, reflect in (("scale", 1.0, True), ("offset", 0.0, True),
+                                        ("alpha", 1.0, False),
+                                        ("clip", (-float("inf"), float("inf")), False)):
+            value = getattr(cfg, field)
+            if value is None:
+                continue
+            values = _values(value, names, default)
+            setattr(cfg, field, {name: item * sign if reflect else item
+                                for name, item, sign in zip(routed, values, signs)})
+        deferred = set(_names(cfg.defer_clip_joint_names, names))
+        cfg.defer_clip_joint_names = tuple(dest for name, dest in zip(names, routed) if name in deferred)
+    cfg.joint_names = routed
+    cfg.preserve_order = True
+
+
+def reward_joint_scope(env_cfg, suffix):
+    """Unified scope takes precedence; old qdev-only overrides keep their meaning."""
+    scope = _get(env_cfg, "side_rewd_scope")
+    field = "side_rewd_scope"
+    if scope is None:
+        scope = _get(env_cfg, "qdev_joint_scope", "configured") if suffix == "help_qdev" else "configured"
+        field = "qdev_joint_scope"
+    if scope not in ("configured", "controlled"):
+        raise ValueError(f"env.{field} must be 'configured' or 'controlled'.")
+    return scope
+
+
+def is_joint_control_reward(suffix, asset):
+    """Include additional sided joint costs with explicit joint selectors."""
+    return suffix in JOINT_CONTROL_REWARDS or _get(asset, "joint_names") is not None
+
+
+def resolve_action_reward_scopes(env_cfg, joint_names, arm_signs):
+    """Allocate sided physical-joint costs to the action that controls them.
+
+    Configured subsets retain their joint kinds (including legs and waist).
+    Arm selectors, whether authored ipsilaterally or already resolved, follow
+    the action's arm. 'controlled' covers every action joint for joint costs.
+    Limb-speed costs retain their selected body types. Global and foot rewards
+    do not change. A separate common action owns the extracted waist costs.
+    """
+    reward_joint_scope(env_cfg, "help_qdev")  # Validate even if qdev is disabled.
+    rewards = _get(env_cfg, "rewards")
+    if rewards is None:
+        return
+    terms = list(rewards.items() if isinstance(rewards, Mapping) else vars(rewards).items())
+    for side in ("left", "right", "common"):
+        action = _get(_get(env_cfg, "actions"), f"{side}_joint_pos")
+        if action is None or not hasattr(action, "contralateral_arms"):
+            continue
+        controlled = list(action.joint_names)
+        # Resolved physical names are authoritative, including partial actions.
+        arm_side = next((n.split("_", 1)[0] for n in controlled
+                         if _arm_sign(n, arm_signs) is not None), None)
+
+        def owned_names(selectors, *, bodies=False):
+            universe = [n.replace("_joint", "_link") for n in joint_names] if bodies else joint_names
+            selected = _names(selectors, universe, unique=False)
+            owned = set()
+            for name in selected:
+                joint = name.replace("_link", "_joint") if bodies else name
+                if arm_side is not None and _arm_sign(joint, arm_signs) is not None:
+                    joint = arm_side + "_" + joint.split("_", 1)[1]
+                if joint in controlled:
+                    owned.add(joint)
+            result = [n for n in controlled if n in owned]
+            return [n.replace("_joint", "_link") for n in result] if bodies else result
+
+        for name, term in terms:
+            if not name.startswith(side + "_"):
+                continue
+            suffix = name[len(side) + 1:]
+            asset = _get(_get(term, "params", {}), "asset_cfg")
+            if asset is None or _get(asset, "name") != action.asset_name:
+                continue
+            bodies = suffix == "safe_limb_speed"
+            if not bodies and not is_joint_control_reward(suffix, asset):
+                continue
+            name_field, id_field = ("body_names", "body_ids") if bodies else ("joint_names", "joint_ids")
+            selectors = _get(asset, name_field)
+            all_controlled = not bodies and reward_joint_scope(env_cfg, suffix) == "controlled"
+            if not all_controlled and selectors is None and _get(asset, id_field, slice(None)) != slice(None):
+                raise ValueError(f"{side}_{suffix} needs explicit {name_field} for action ownership resolution.")
+            selected = (controlled if all_controlled
+                        else owned_names(selectors, bodies=bodies))
+            if not selected:
+                raise ValueError(f"{side}_{suffix} selects no joints/bodies controlled by {side}_joint_pos.")
+            _set(asset, name_field, list(selected))
+            _set(asset, id_field, slice(None))
+            _set(asset, "preserve_order", True)
